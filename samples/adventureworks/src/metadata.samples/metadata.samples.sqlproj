<Project Sdk="Microsoft.Build.Sql/2.1.0">
  <!-- =========================
       Global Project Settings
       ========================= -->
  <PropertyGroup>
    <Name>metadata.samples</Name>
    <AssemblyName>cloudformations.cumulus.samples</AssemblyName>
    <RootNamespace>cloudformations.cumulus.samples</RootNamespace>
    <OutputType>Database</OutputType>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>
    <!-- Azure SQL -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033,CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <DefaultFilegroup>PRIMARY</DefaultFilegroup>
    <DefaultSchema>cumulus.samples</DefaultSchema>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DeployToDatabase>true</DeployToDatabase>
    <IncludeCompositeObjects>true</IncludeCompositeObjects>
    <TargetDatabaseSet>true</TargetDatabaseSet>
    <SqlServerVerification>false</SqlServerVerification>
    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>
    <!-- Required for CI / SDK builds -->
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <!-- =========================
       Configuration
       ========================= -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- =========================
       Project References
       ========================= 
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\metadata.common\metadata.common.sqlproj" />
    <ProjectReference Include="..\..\..\..\src\metadata.control\metadata.control.sqlproj" />
    <ProjectReference Include="..\..\..\..\src\metadata.ingest\metadata.ingest.sqlproj" />
    <ProjectReference Include="..\..\..\..\src\metadata.transform\metadata.transform.sqlproj" />
  </ItemGroup> -->
  <!-- =========================
       Auto-include helpers
       ========================= -->
  <!-- Generate Scripts\Core\_AutoInclude.sql -->
  <Target Name="GenerateCoreScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <CoreScripts Include="Scripts\Core\*.sql" Exclude="Scripts\Core\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Core\_AutoInclude.sql" Lines="@(CoreScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
    <!-- Generate Scripts\Data\Ingest\_AutoInclude.sql -->
  <Target Name="GenerateIngestScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <IngestScripts Include="Scripts\Data\Ingest\*.sql" Exclude="Scripts\Data\Ingest\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Data\Ingest\_AutoInclude.sql" Lines="@(IngestScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
  <!-- Generate Scripts\Data\Transform\_AutoInclude.sql -->
  <Target Name="GenerateTransformScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <TransformScripts Include="Scripts\Data\Transform\*.sql" Exclude="Scripts\Data\Transform\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Data\Transform\_AutoInclude.sql" Lines="@(TransformScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
  <!-- =========================
       Deployment Scripts
       ========================= -->
  <ItemGroup>
    <PreDeploy Include="Scripts\Script.PreDeployment.sql" />
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>
  <!-- =========================
       SQLCMD Variables
       ========================= -->
  <ItemGroup>
    <SqlCmdVariable Include="AdventureWorksServerName" Value="$(SqlCmdVar__1)" />
    <SqlCmdVariable Include="AdventureWorksDatabaseName" Value="$(SqlCmdVar__2)" />
    <SqlCmdVariable Include="ADFName" Value="$(SqlCmdVar__4)" />
  </ItemGroup>
  <!-- =========================
       NetCore / CI Support
       ========================= -->
  <ItemGroup Condition="'$(NetCoreBuild)'=='true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>