<Project Sdk="Microsoft.Build.Sql/0.1.14-preview">
  <!-- =========================
       Global Project Settings
       ========================= -->
  <PropertyGroup>
    <Name>metadata.data</Name>
    <AssemblyName>metadata.data</AssemblyName>
    <RootNamespace>metadata.data</RootNamespace>
    <OutputType>Database</OutputType>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>
    <!-- Azure SQL -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DeployToDatabase>true</DeployToDatabase>
    <IncludeCompositeObjects>true</IncludeCompositeObjects>
    <TargetDatabaseSet>true</TargetDatabaseSet>
    <SqlServerVerification>false</SqlServerVerification>
    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>
    <!-- Required for CI / SDK builds -->
    <TargetFramework>net472</TargetFramework>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <!-- =========================
       Configuration
       ========================= -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- =========================
       Deployment Scripts
       ========================= -->
  <ItemGroup>
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>
  <!-- =========================
       Non-model / Utility Files
       ========================= -->
  <ItemGroup>
    <None Include="metadata.data.publish.xml" />
    <None Include="Scripts\ConnectionsMetadataAsCode.sql" />
    <None Include="Scripts\Control\ControlPipelineMetadataAsCode.sql" />
    <None Include="Scripts\ControlWaitPipelineMetadataAsCode.sql" />
    <None Include="Scripts\Ingest\Product.sql" />
    <None Include="Scripts\Ingest\SalesOrderDetail.sql" />
    <None Include="Scripts\Ingest\SalesOrderHeader.sql" />
    <None Include="Scripts\Transform\DimDate.sql" />
    <None Include="Scripts\Transform\DimProducts.sql" />
    <None Include="Scripts\Transform\FactSales.sql" />
  </ItemGroup>
  <!-- =========================
       SQLCMD Variables
       ========================= -->
  <ItemGroup>
    <SqlCmdVariable Include="DemoConnectionLocation" Value="$(SqlCmdVar__1)" />
    <SqlCmdVariable Include="DemoSourceLocation" Value="$(SqlCmdVar__2)" />
    <SqlCmdVariable Include="DemoResourceName" Value="$(SqlCmdVar__3)" />
    <SqlCmdVariable Include="DemoLinkedService" Value="$(SqlCmdVar__4)" />
    <SqlCmdVariable Include="DemoUsername" Value="$(SqlCmdVar__5)" />
    <SqlCmdVariable Include="DemoKVSecret" Value="$(SqlCmdVar__6)" />
    <SqlCmdVariable Include="ADFName" Value="$(SqlCmdVar__7)" />
  </ItemGroup>
  <!-- =========================
       Project References
       ========================= -->
  <ItemGroup>
    <ProjectReference Include="..\metadata.common\metadata.common.sqlproj" />
    <ProjectReference Include="..\metadata.ingest\metadata.ingest.sqlproj" />
    <ProjectReference Include="..\metadata.control\metadata.control.sqlproj" />
    <ProjectReference Include="..\metadata.transform\metadata.transform.sqlproj" />
  </ItemGroup>
  <!-- =========================
       NetCore / CI Support
       ========================= -->
  <ItemGroup Condition="'$(NetCoreBuild)'=='true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>
  <!-- =========================
       Auto-include helpers
       ========================= -->
  <!-- Generate Scripts\Ingest\_AutoInclude.sql -->
  <Target Name="GenerateIngestScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <IngestScripts Include="Scripts\Ingest\*.sql" Exclude="Scripts\Ingest\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Ingest\_AutoInclude.sql" Lines="@(IngestScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
  <!-- Generate Scripts\Transform\_AutoInclude.sql -->
  <Target Name="GenerateTransformScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <TransformScripts Include="Scripts\Transform\*.sql" Exclude="Scripts\Transform\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Transform\_AutoInclude.sql" Lines="@(TransformScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
  <!-- Generate Scripts\Control\_AutoInclude.sql -->
  <Target Name="GenerateControlScripts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ControlScripts Include="Scripts\Control\*.sql" Exclude="Scripts\Control\_AutoInclude.sql" />
    </ItemGroup>
    <WriteLinesToFile File="Scripts\Control\_AutoInclude.sql" Lines="@(ControlScripts->':r .\%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
</Project>