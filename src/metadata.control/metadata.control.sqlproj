<Project Sdk="Microsoft.Build.Sql/0.1.14-preview">

  <!-- =========================
       Global Project Settings
       ========================= -->
  <PropertyGroup>
    <Name>metadata.control</Name>
    <AssemblyName>cloudformations.cumulus</AssemblyName>
    <RootNamespace>cloudformations.cumulus</RootNamespace>

    <OutputType>Database</OutputType>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>

    <!-- Azure SQL -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>

    <ModelCollation>1033,CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <DefaultFilegroup>PRIMARY</DefaultFilegroup>
    <DefaultSchema>cumulus.control</DefaultSchema>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>

    <DeployToDatabase>true</DeployToDatabase>
    <IncludeCompositeObjects>true</IncludeCompositeObjects>
    <TargetDatabaseSet>true</TargetDatabaseSet>
    <SqlServerVerification>false</SqlServerVerification>

    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>

    <!-- Required for CI / SDK builds -->
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- =========================
       Configuration
       ========================= -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- =========================
       Project References
       ========================= -->
  <ItemGroup>
    <ProjectReference Include="..\metadata.common\metadata.common.sqlproj" />
  </ItemGroup>

  <!-- =========================
       Deployment Scripts
       ========================= -->
  <ItemGroup>
    <PreDeploy Include="Scripts\Script.PreDeployment.sql" />
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>

  <!-- =========================
       Excluded / Utility Scripts
       ========================= -->
  <ItemGroup>
    <None Include="metadata.control.publish.xml" />
    <None Include="Scripts\DefaultProperties.sql" />
    <None Include="Scripts\MetadataAsCodeControl.sql" />
    <None Include="Scripts\BatchDaily.sql" />
    <None Include="Security\db_cumulususer.sql" />
  </ItemGroup>

  <!-- =========================
       SQLCMD Variables
       ========================= -->
  <ItemGroup>
    <SqlCmdVariable Include="TenantID"       Value="$(SqlCmdVar__1)" />
    <SqlCmdVariable Include="Environment"    Value="$(SqlCmdVar__2)" />
    <SqlCmdVariable Include="SubscriptionID" Value="$(SqlCmdVar__3)" />
    <SqlCmdVariable Include="ADFName"         Value="$(SqlCmdVar__4)" />
    <SqlCmdVariable Include="RGName"          Value="$(SqlCmdVar__5)" />
  </ItemGroup>

  <!-- =========================
       NetCore / CI Support
       ========================= -->
  <ItemGroup Condition="'$(NetCoreBuild)'=='true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.0"
                      PrivateAssets="All" />
  </ItemGroup>

</Project>