<Project Sdk="Microsoft.Build.Sql/2.1.0">
  <!-- =========================
       Global Project Settings
       ========================= -->
  <PropertyGroup>
    <Name>metadata.core</Name>
    <AssemblyName>metadata.core</AssemblyName>
    <RootNamespace>metadata.core</RootNamespace>
    <OutputType>Database</OutputType>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>4.1</ProjectVersion>
    <!-- Azure SQL -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DeployToDatabase>true</DeployToDatabase>
    <IncludeCompositeObjects>true</IncludeCompositeObjects>
    <TargetDatabaseSet>true</TargetDatabaseSet>
    <SqlServerVerification>false</SqlServerVerification>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
    <BuildScriptName>$(MSBuildProjectName).sql</BuildScriptName>
    <!-- Required for CI / SDK builds -->
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <!-- =========================
       Configuration
       ========================= -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- =========================
       Project References
       ========================= -->
  <ItemGroup>
    <ProjectReference Include="..\metadata.common\metadata.common.sqlproj" />
    <ProjectReference Include="..\metadata.control\metadata.control.sqlproj" />
    <ProjectReference Include="..\metadata.ingest\metadata.ingest.sqlproj" />
    <ProjectReference Include="..\metadata.transform\metadata.transform.sqlproj" />
  </ItemGroup>
  <!-- =========================
       Deployment Scripts
       ========================= -->
  <ItemGroup>
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>
  <!-- =========================
       SQLCMD Variables
       ========================= -->
  <ItemGroup>
    <SqlCmdVariable Include="DLSName" Value="$(SqlCmdVar__1)" />
    <SqlCmdVariable Include="KeyVaultName" Value="$(SqlCmdVar__4)" />
    <SqlCmdVariable Include="RGName" Value="$(SqlCmdVar__5)" />
    <SqlCmdVariable Include="SubscriptionID" Value="$(SqlCmdVar__6)" />
    <SqlCmdVariable Include="DatabricksHost" Value="$(SqlCmdVar__13)" />
    <SqlCmdVariable Include="DatabricksWSName" Value="$(SqlCmdVar__14)" />
    <SqlCmdVariable Include="Environment" Value="$(SqlCmdVar__15)" />
    <SqlCmdVariable Include="TenantID" Value="$(SqlCmdVar__16)" />
    <SqlCmdVariable Include="ADFName" Value="$(SqlCmdVar__17)" />
  </ItemGroup>
  <!-- =========================
       NetCore / CI Support
       ========================= -->
  <ItemGroup Condition="'$(NetCoreBuild)'=='true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>